{
  "name": "digital-scam-investigator",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "workspaces": [
    "Frontend",
    "Backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"server,client\" -c \"cyan,green\" \"npm run server\" \"npm run client\"",
    "server": "tsx watch Backend/src/index.ts",
    "client": "vite --config Frontend/vite.config.ts",
    "start": "tsx Backend/src/index.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:validation": "tsx Tests/validation/run_45_validation_run.ts",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p Backend/tsconfig.json --noEmit",
    "build:frontend": "tsc -p Frontend/tsconfig.json && vite build Frontend",
    "lint": "oxlint",
    "preview": "vite preview Frontend"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "openai": "^7.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
